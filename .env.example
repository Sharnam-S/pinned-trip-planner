# --- Required ---

# Anthropic API key — query planning, video curation, spot extraction.
ANTHROPIC_API_KEY=

# Google Maps API key — geocoding spots + rendering the map.
GOOGLE_MAPS_API_KEY=

# --- YouTube reliability on deployed hosts (Vercel) ---
# YouTube blocks requests from datacenter IPs, so transcript/search fetching
# works locally but fails once deployed. These two vars fix that. Both are
# optional: unset, the app behaves exactly as it does in local dev.

# Official YouTube Data API v3 key. When set, search + metadata use the
# official API (reliable from datacenter IPs — no bot check) instead of the
# keyless InnerTube search. Get one at:
#   https://console.cloud.google.com/  ->  enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Residential/rotating proxy for ALL YouTube requests (InnerTube search/info,
# BotGuard challenge, caption download, oEmbed). Required to fetch transcripts
# reliably from Vercel — there is no official transcript API for arbitrary
# videos, so this is what escapes the flagged datacenter IP. Any standard proxy
# URL works (Bright Data / Oxylabs / Webshare / IPRoyal residential, etc.):
#   http://user:pass@host:port
YOUTUBE_PROXY_URL=

# --- Accounts (Google SSO + per-user trips) ---
# All three unset in local dev = a built-in "Dev User" signs in instantly and
# trips persist to a zero-setup local Postgres (PGlite, under .data/). On
# Vercel, leaving these unset degrades to the old single-user behavior.

# Google OAuth web client (console.cloud.google.com -> Credentials ->
# OAuth client ID -> Web application). Authorized redirect URI:
#   https://<your-domain>/api/auth/callback   (+ http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret for signing session cookies — `openssl rand -base64 32`.
AUTH_SECRET=

# Postgres connection string (Neon / Vercel Postgres) for users, trips, chats.
DATABASE_URL=

# --- Optional ---

# Vercel Blob token — shared trip library across devices (auto-set on Vercel).
BLOB_READ_WRITE_TOKEN=

# Override the spot-extraction model (defaults to claude-sonnet-4-6).
# Left COMMENTED OUT on purpose: `run.sh` copies this file to .env.local
# verbatim, and any key with a code-side default must stay unset rather than set
# to "" — an empty value is not "absent", it's an empty model id.
# EXTRACT_MODEL=claude-haiku-4-5

# PostHog project API key (phc_...) — enables LLM analytics: every Claude call
# is captured as an $ai_generation event (model, tokens, cost, latency, full
# prompt/response) and shows up under LLM analytics in PostHog. Unset, nothing
# is sent. Find it at posthog.com -> Settings -> Project -> Project API key.
POSTHOG_API_KEY=

# PostHog ingestion host. Defaults to https://us.i.posthog.com (US cloud).
# Commented out for the same reason as EXTRACT_MODEL above — uncomment only to
# point somewhere else, e.g. EU cloud.
# POSTHOG_HOST=https://eu.i.posthog.com
