# --- Required ---

# Anthropic API key — query planning, video curation, spot extraction.
ANTHROPIC_API_KEY=

# Google Maps API key — geocoding spots + rendering the map.
GOOGLE_MAPS_API_KEY=

# --- YouTube reliability on deployed hosts (Vercel) ---
# YouTube blocks requests from datacenter IPs, so transcript/search fetching
# works locally but fails once deployed. These two vars fix that. Both are
# optional: unset, the app behaves exactly as it does in local dev.

# Official YouTube Data API v3 key. When set, search + metadata use the
# official API (reliable from datacenter IPs — no bot check) instead of the
# keyless InnerTube search. Get one at:
#   https://console.cloud.google.com/  ->  enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Residential/rotating proxy for ALL YouTube requests (InnerTube search/info,
# BotGuard challenge, caption download, oEmbed). Required to fetch transcripts
# reliably from Vercel — there is no official transcript API for arbitrary
# videos, so this is what escapes the flagged datacenter IP. Any standard proxy
# URL works (Bright Data / Oxylabs / Webshare / IPRoyal residential, etc.):
#   http://user:pass@host:port
YOUTUBE_PROXY_URL=

# --- Optional ---

# Vercel Blob token — shared trip library across devices (auto-set on Vercel).
BLOB_READ_WRITE_TOKEN=

# Override the spot-extraction model (defaults to claude-sonnet-4-6).
EXTRACT_MODEL=
